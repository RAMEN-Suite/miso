# For development and production. Checked by the server at startup (server/src/env.ts): it exits with a list of the
# problems if a required variable is missing or a value is invalid. Empty values count as not set.
APP_HOST=localhost # Optional, default "localhost". "localhost" for development or server name for deployment
APP_PORT=8080 # Required. Port of your backend app that provides the API
DATABASE_NAME=neo4j # Optional, default "neo4j". Name of the database
FAVICON_URL=https://my-website.com/favicon.ico # Optional. http(s) URL to the favicon. File ending can be .ico, .svg, .jpg, .jpeg, or .png
GUIDELINES_URL=https://my-config-provider.com/project.miso.json # Required. http(s) URL or file name (in the config directory) of the Miso config.
# MODEL_URL=https://my-model-provider.com/project.ramen.json # Not used yet: drift check of the ingested model against the original model
LOG_LEVEL=warn # Optional, default "debug". Severity level from which messages are displayed in the console (development) or log files (production): "fatal", "error", "warn", "info", "http" or "debug"
NEO4J_PW=password # Required. Password for neo4j database
NEO4J_URI=neo4j://neo4j:7687 # Required. Connection URI for neo4j driver. During development the scheme might be "bolt://"
NEO4J_USER=neo4j # Required. Username for neo4j database
NODE_ENV=development # Optional. "development" (console logs) or "production" (log files); without it, both
PROTOCOL=http # Optional, default "http". "http" or "https"
TORI_URL=https://tori.example.com # Optional. http(s) base URL of Tori. Miso redirects there for entities
SHOYU_URL=https://shoyu.example.de # Optional. http(s) base URL of Shoyu. Miso redirects there to see collections and content

# Only for production:
SSL_CERT_NAME=my-website-ssl-certificate.crt # Name of SSL certificate file. File ending can be .crt or .pem
SSL_KEY_NAME=my-website-private-key.key # Name of private key file. File ending is likely .key